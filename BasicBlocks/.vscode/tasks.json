{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (Debug, Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-G",
        "Ninja",
        "-B",
        "build-debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_C_COMPILER=C:/msys64N/ucrt64/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=C:/msys64N/ucrt64/bin/g++.exe"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Build (Debug, Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-debug"
      ],
      "dependsOn": "CMake Configure (Debug, Ninja)",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Configure (Release, Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-G",
        "Ninja",
        "-B",
        "build-release",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_COMPILER=C:/msys64N/ucrt64/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=C:/msys64N/ucrt64/bin/g++.exe"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Build (Release, Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-release"
      ],
      "dependsOn": "CMake Configure (Release, Ninja)",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Configure (Debug, MSVC)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64",
        "-B",
        "build-msvc-debug",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CMake Build (Debug, MSVC)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-msvc-debug",
        "--config",
        "Debug"
      ],
      "dependsOn": "CMake Configure (Debug, MSVC)",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake Configure (Release, MSVC)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64",
        "-B",
        "build-msvc-release",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake Build (Release, MSVC)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-msvc-release",
        "--config",
        "Release"
      ],
      "dependsOn": "CMake Configure (Release, MSVC)",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
