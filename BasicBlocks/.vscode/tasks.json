{
  "version": "2.0.0",
  "tasks": [
    // 🔧 Configure tasks
    {
      "label": "Configure: GCC Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1",
        "-Config", "Debug",
        "-Toolchain", "GCC",
        "-ConfigureOnly"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Configure: MSVC Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1",
        "-Config", "Debug",
        "-Toolchain", "MSVC",
        "-ConfigureOnly"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },

    // 🟢 Build tasks
    {
      "label": "Build: GCC Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1",
        "-Config", "Debug",
        "-Toolchain", "GCC"
      ],
      "group": "build",
      "dependsOn": "Configure: GCC Debug",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build: MSVC Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1",
        "-Config", "Debug",
        "-Toolchain", "MSVC"
      ],
      "group": "build",
      "dependsOn": "Configure: MSVC Debug",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build: All (GCC + MSVC)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1",
        "-Config", "All",
        "-Toolchain", "Both"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc", "$msCompile"]
    },

    // 🧹 Clean task
    {
      "label": "Clean Workspace",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1",
        "-CleanOnly"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
