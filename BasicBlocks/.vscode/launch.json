{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run / Debug (GCC Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/dist/gcc/bin/dist/bin/App.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64N/ucrt64/bin/gdb.exe",
